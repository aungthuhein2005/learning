---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 0 && (
  <nav aria-label="On this page" class="text-sm">
    <p class="font-mono text-[0.72rem] uppercase tracking-wide text-[var(--color-fg-faint)] mb-3">On this page</p>
    <ul class="space-y-2 border-l border-[var(--color-border)]">
      {items.map((h) => (
        <li class={h.depth === 3 ? 'pl-6' : 'pl-3'}>
          <a
            href={`#${h.slug}`}
            class="block -ml-px border-l pl-3 border-transparent text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] hover:border-[var(--color-fg-muted)] transition-colors"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

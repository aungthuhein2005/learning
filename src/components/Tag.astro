---
import { withBase } from '../lib/url';

interface Props {
  tag: string;
}

const { tag } = Astro.props;
---

<a
  href={withBase(`/tags/${tag}`)}
  class="inline-block rounded-full border border-[var(--color-border-strong)] px-2.5 py-0.5 font-mono text-[0.72rem] text-[var(--color-fg-muted)] hover:text-[var(--color-fg)] hover:border-[var(--color-fg-muted)] transition-colors"
>
  {tag}
</a>

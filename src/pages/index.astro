---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import { getPublished, byDateDesc, formatDate, noteHref } from '../lib/content';
import { withBase } from '../lib/url';

const notes = byDateDesc(await getPublished('notes'));
const experiments = byDateDesc(await getPublished('experiments'));
const projects = await getPublished('projects');

const featuredNotes = notes.slice(0, 3);
const recentExperiments = experiments.slice(0, 2);
const notebookNote = notes[0];
const featuredProjects = projects.filter((p) => p.data.featured);

const currentlyLearning = ['Machine Learning', 'Data Structures & Algorithms', 'Mathematics', 'Big Data'];
---

<BaseLayout
  title="Learning Lab"
  description="Notes, implementations, experiments, and ideas from my journey through Computer Science and AI."
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 pb-14 sm:pt-20 sm:pb-16">
    <p class="font-mono text-sm text-[var(--color-fg-muted)] tracking-wide">AUNG THU HEIN</p>
    <h1 class="mt-2 text-4xl sm:text-5xl font-bold tracking-tight max-w-2xl">
      Learning Computer Science in public.
    </h1>
    <p class="mt-5 max-w-xl text-lg text-[var(--color-fg-muted)] leading-relaxed">
      Notes, implementations, experiments, and ideas from my journey through Computer Science and AI.
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a
        href={withBase('/learn')}
        class="rounded-md bg-[var(--color-fg)] text-[var(--color-bg)] px-4 py-2.5 text-sm font-medium hover:opacity-85 transition-opacity"
      >
        Explore the notes
      </a>
      <a
        href={withBase('/about')}
        class="rounded-md border border-[var(--color-border-strong)] px-4 py-2.5 text-sm font-medium hover:bg-[var(--color-bg-subtle)] transition-colors"
      >
        About me
      </a>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)] bg-[var(--color-bg-subtle)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10">
      <h2 class="font-mono text-xs uppercase tracking-wide text-[var(--color-fg-faint)] mb-4">Currently learning</h2>
      <div class="flex flex-wrap gap-2">
        {currentlyLearning.map((item) => (
          <span class="rounded-full border border-[var(--color-border-strong)] bg-[var(--color-bg)] px-3.5 py-1.5 text-sm">
            {item}
          </span>
        ))}
      </div>
    </div>
  </section>

  {featuredNotes.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 sm:px-6 py-14">
      <div class="flex items-baseline justify-between mb-5">
        <h2 class="font-mono text-xs uppercase tracking-wide text-[var(--color-fg-faint)]">Featured notes</h2>
        <a href={withBase('/learn')} class="text-sm text-[var(--color-accent)] hover:underline">Browse all &rarr;</a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {featuredNotes.map((note) => (
          <ContentCard
            href={noteHref(note)}
            title={note.data.title}
            description={note.data.description}
            eyebrow={note.data.category}
            meta={formatDate(note.data.date)}
          />
        ))}
      </div>
    </section>
  )}

  {recentExperiments.length > 0 && (
    <section class="border-t border-[var(--color-border)]">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14">
        <div class="flex items-baseline justify-between mb-5">
          <h2 class="font-mono text-xs uppercase tracking-wide text-[var(--color-fg-faint)]">Recent experiments</h2>
          <a href={withBase('/experiments')} class="text-sm text-[var(--color-accent)] hover:underline">All experiments &rarr;</a>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          {recentExperiments.map((exp) => (
            <ContentCard
              href={`/experiments/${exp.id}`}
              title={exp.data.title}
              description={exp.data.description}
              eyebrow="Experiment"
              meta={formatDate(exp.data.date)}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {notebookNote && (
    <section class="border-t border-[var(--color-border)] bg-[var(--color-bg-subtle)]">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14">
        <h2 class="font-mono text-xs uppercase tracking-wide text-[var(--color-fg-faint)] mb-5">From the notebook</h2>
        <blockquote class="max-w-2xl border-l-2 border-[var(--color-accent)] pl-5 text-lg leading-relaxed text-[var(--color-fg)]">
          {notebookNote.data.description}
        </blockquote>
        <a href={withBase(noteHref(notebookNote))} class="mt-4 inline-block text-sm text-[var(--color-accent)] hover:underline">
          Read &ldquo;{notebookNote.data.title}&rdquo; &rarr;
        </a>
      </div>
    </section>
  )}

  {featuredProjects.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 sm:px-6 py-14">
      <div class="flex items-baseline justify-between mb-5">
        <h2 class="font-mono text-xs uppercase tracking-wide text-[var(--color-fg-faint)]">Projects</h2>
        <a href={withBase('/projects')} class="text-sm text-[var(--color-accent)] hover:underline">All projects &rarr;</a>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {featuredProjects.map((project) => (
          <ContentCard
            href={`/projects/${project.id}`}
            title={project.data.title}
            description={project.data.description}
            eyebrow={project.data.status}
            meta={project.data.tech.join(' · ')}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

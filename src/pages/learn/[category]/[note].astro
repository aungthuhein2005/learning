---
import { render } from 'astro:content';
import NoteLayout from '../../../layouts/NoteLayout.astro';
import { getPublished, getRelatedNotes } from '../../../lib/content';

export async function getStaticPaths() {
  const notes = await getPublished('notes');
  return notes.map((entry) => ({
    params: { category: entry.data.category, note: entry.id.split('/').pop() },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const relatedNotes = await getRelatedNotes(entry.data.related);
---

<NoteLayout entry={entry} headings={headings} relatedNotes={relatedNotes} body={entry.body ?? ''}>
  <Content />
</NoteLayout>

---
import { render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import { getPublished, getRelatedNotes, formatDate, noteHref } from '../../lib/content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getPublished('projects');
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const relatedNotes = await getRelatedNotes(entry.data.relatedNotes);
---

<DocLayout
  title={entry.data.title}
  description={entry.data.description}
  eyebrow="Project"
  metaLine={`${entry.data.status} · Updated ${formatDate(entry.data.updated ?? entry.data.date)}`}
  headings={headings}
>
  <Fragment slot="links">
    <div class="flex flex-wrap items-center gap-2 mb-8">
      {entry.data.tech.map((t) => (
        <span class="rounded-full border border-[var(--color-border-strong)] px-3 py-1 font-mono text-[0.72rem] text-[var(--color-fg-muted)]">{t}</span>
      ))}
      {entry.data.github && (
        <a href={entry.data.github} target="_blank" rel="noopener noreferrer" class="rounded-md border border-[var(--color-border-strong)] px-3 py-1 text-sm hover:bg-[var(--color-bg-subtle)]">
          GitHub &rarr;
        </a>
      )}
      {entry.data.live && (
        <a href={entry.data.live} target="_blank" rel="noopener noreferrer" class="rounded-md border border-[var(--color-border-strong)] px-3 py-1 text-sm hover:bg-[var(--color-bg-subtle)]">
          Live &rarr;
        </a>
      )}
    </div>
  </Fragment>

  <Content />

  <Fragment slot="after">
    {relatedNotes.length > 0 && (
      <div class="pt-6 border-t border-[var(--color-border)]">
        <p class="font-mono text-[0.72rem] uppercase tracking-wide text-[var(--color-fg-faint)] mb-3">Related notes</p>
        <ul class="space-y-1.5">
          {relatedNotes.map((note) => (
            <li><a href={withBase(noteHref(note))} class="text-[var(--color-accent)] hover:underline">{note.data.title}</a></li>
          ))}
        </ul>
      </div>
    )}
  </Fragment>
</DocLayout>

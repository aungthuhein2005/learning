---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getPublished, byDateDesc } from '../../lib/content';

const projects = byDateDesc(await getPublished('projects'));
---

<BaseLayout
  title="Projects"
  description="Open-source software and experiments I've built, including BurmeseNLP."
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12">
    <h1 class="text-3xl font-bold tracking-tight">Projects</h1>
    <p class="mt-2 max-w-2xl text-[var(--color-fg-muted)]">
      What I built, what I learned, and the technical challenges along the way — not project READMEs.
    </p>

    <div class="mt-10 grid sm:grid-cols-2 gap-4">
      {projects.map((project) => (
        <ContentCard
          href={`/projects/${project.id}`}
          title={project.data.title}
          description={project.data.description}
          eyebrow={project.data.status}
          meta={project.data.tech.join(' · ')}
        />
      ))}
    </div>
  </div>
</BaseLayout>
